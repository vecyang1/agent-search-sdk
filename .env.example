# Agent Search SDK Environment Configuration
# Copy this file to .env and configure provider API keys

# Brave Search API Key (Tier 1)
BRAVE_API_KEY=

# Tavily Search API Key (Tier 1 LLM snippets)
TAVILY_API_KEY=

# SerpAPI Key or comma-separated pool of keys
SERPAPI_API_KEY=
# SERPAPI_API_KEYS=key1,key2

# Self-hosted SearXNG instance URL & Cloudflare Access service credentials (if protected)
SEARXNG_BASE_URL=https://searx.example.com
SEARXNG_CF_CLIENT_ID=
SEARXNG_CF_CLIENT_SECRET=
SEARXNG_LANGUAGE=en

# Search strategy preset: balanced (default: Brave -> Tavily -> SerpAPI -> SearXNG -> DuckDuckGo) | fast | comprehensive
SEARCH_PRESET=balanced

# DuckDuckGo fallback backend: auto | lite | ddgs
AGENT_SEARCH_DDG_BACKEND=auto

# Maximum HTTP retries on 429/503 rate limits
AGENT_SEARCH_HTTP_MAX_RETRIES=1

# Enable 1Password CLI unattended credential retrieval (0 or 1)
AGENT_SEARCH_1PASSWORD=0
